# ==========================================================
# Saffron India Backend - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to GitHub!
# ==========================================================

# Database: Supabase PostgreSQL Connection URL
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password_here@db.your_project_ref.supabase.co:5432/postgres

# Flask Session Security Key
SECRET_KEY=replace_with_a_long_random_secret_key

# Environment: "development" for local, "production" for Vercel
FLASK_ENV=development

# Frontend URL for CORS (Leave empty for same-origin or local dev)
FRONTEND_URL=

# Gmail SMTP Email Configuration (Requires a 16-character Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM=your_email@gmail.com
