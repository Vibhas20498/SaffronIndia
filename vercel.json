{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "backend/**",
        "*.html",
        "*.css",
        "*.js",
        "static/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__vercel_route__=:path*"
    }
  ]
}
